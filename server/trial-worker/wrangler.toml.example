name = "musacad-trial-api"
main = "src/index.js"
compatibility_date = "2026-09-01"

[vars]
MUSACAD_PACKAGE_NAME = "com.musa.cad"
MUSACAD_PLAY_PRODUCT_ID = "musacad_pro"
MUSACAD_PLAY_SERVICE_ACCOUNT_EMAIL = "REPLACE_WITH_SERVICE_ACCOUNT_EMAIL"
MUSACAD_PLAY_ALLOW_LEGACY_UNBOUND = "false"

# Create a D1 database, then replace these placeholders in a local wrangler.toml.
[[d1_databases]]
binding = "DB"
database_name = "musacad-trials"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Never put private keys in this file or Git.
# Add both as encrypted Worker secrets:
# - MUSACAD_TRIAL_PRIVATE_KEY_PEM
# - MUSACAD_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY_PEM
