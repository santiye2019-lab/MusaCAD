<resources>
    <style name="Theme.MusaCAD" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cad_blue</item>
        <item name="colorPrimaryVariant">#072840</item>
        <item name="colorSecondary">@color/cad_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#071015</item>
        <item name="android:statusBarColor">#0C324D</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="ToolButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">74dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:textColor">@color/tool_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawableTint">@color/tool_text</item>
    </style>

    <style name="ToolButtonBlue" parent="ToolButton"><item name="android:background">@drawable/tool_tile_blue</item></style>
    <style name="ToolButtonTeal" parent="ToolButton"><item name="android:background">@drawable/tool_tile_teal</item></style>
    <style name="ToolButtonPurple" parent="ToolButton"><item name="android:background">@drawable/tool_tile_purple</item></style>
    <style name="ToolButtonOrange" parent="ToolButton"><item name="android:background">@drawable/tool_tile_orange</item></style>
    <style name="ToolButtonGreen" parent="ToolButton"><item name="android:background">@drawable/tool_tile_green</item></style>
    <style name="ToolButtonMagenta" parent="ToolButton"><item name="android:background">@drawable/tool_tile_magenta</item></style>
    <style name="ToolButtonYellow" parent="ToolButton"><item name="android:background">@drawable/tool_tile_yellow</item></style>

    <style name="CadTopButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:textColor">#EAF5F7</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/tool_tile_blue</item>
        <item name="android:drawableTint">#EAF5F7</item>
    </style>
    <style name="CadTopButtonBlue" parent="CadTopButton"><item name="android:background">@drawable/tool_tile_blue</item></style>
    <style name="CadTopButtonTeal" parent="CadTopButton"><item name="android:background">@drawable/tool_tile_teal</item></style>
    <style name="CadTopButtonPurple" parent="CadTopButton"><item name="android:background">@drawable/tool_tile_purple</item></style>
    <style name="CadTopButtonOrange" parent="CadTopButton"><item name="android:background">@drawable/tool_tile_orange</item></style>
    <style name="CadTopButtonGreen" parent="CadTopButton"><item name="android:background">@drawable/tool_tile_green</item></style>
    <style name="CadTopButtonMagenta" parent="CadTopButton"><item name="android:background">@drawable/tool_tile_magenta</item></style>
    <style name="CadTopButtonYellow" parent="CadTopButton"><item name="android:background">@drawable/tool_tile_yellow</item><item name="android:textColor">#102028</item><item name="android:drawableTint">#102028</item></style>
</resources>
