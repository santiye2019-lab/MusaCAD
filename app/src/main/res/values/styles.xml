<resources>
    <style name="Theme.MusaCAD" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cad_blue</item><item name="colorPrimaryVariant">#072840</item>
        <item name="colorSecondary">@color/cad_accent</item><item name="android:fontFamily">sans</item>
    </style>
    <style name="CadTool" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item><item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/tool_foreground</item><item name="iconTint">@color/tool_foreground</item>
        <item name="backgroundTint">@color/tool_background</item><item name="cornerRadius">12dp</item>
        <item name="android:minWidth">0dp</item><item name="android:paddingLeft">12dp</item><item name="android:paddingRight">12dp</item>
        <item name="android:insetTop">3dp</item><item name="android:insetBottom">3dp</item>
        <item name="iconSize">20dp</item><item name="iconPadding">6dp</item><item name="iconGravity">textStart</item>
    </style>
</resources>
