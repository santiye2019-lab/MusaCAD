<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/about_blueprint"
        android:scaleType="fitXY"
        android:alpha="0.78"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/splash_logo_bg">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_musacad_mark"
                    android:contentDescription="MusaCAD logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MusaCAD"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="GELİŞTİRİCİ • HAKKINDA"
                android:textColor="#7FD4FF"
                android:textStyle="bold"
                android:textSize="10sp"
                android:letterSpacing="0.10" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="18dp"
                android:background="@drawable/about_panel_bg"
                android:elevation="6dp">

                <FrameLayout
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:background="@drawable/profile_frame_bg"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/developerPhoto"
                        android:layout_width="116dp"
                        android:layout_height="116dp"
                        android:layout_gravity="center"
                        android:background="@drawable/profile_photo_clip"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:contentDescription="Musa Otluoğlu" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Musa Otluoğlu"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Makine Mühendisi • MusaCAD Geliştiricisi"
                    android:textColor="#72E0C9"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1980 • İstanbul   |   Atatürk Üniversitesi • 2004"
                    android:textColor="#AFCAD6"
                    android:textSize="10sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/about_panel_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Profesyonel Biyografi"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="17sp" />

                <View
                    android:layout_width="54dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="#2BC7A5" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1980 İstanbul doğumlu Musa Otluoğlu, Atatürk Üniversitesi Makine Mühendisliği Bölümü’nden 2004 yılında mezun oldu. Mesleki kariyerinin ilk 6 yılında özel inşaat firmalarında Mekanik İşler Şefliği ve koordinatörlük görevlerinde bulundu. Sonraki 17 yıldır kamuda yapım işlerinin kontrol, denetim ve teknik koordinasyon süreçlerinde kontrol mühendisi olarak görev yapmaktadır."
                    android:textColor="#D6E7ED"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/about_stat_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2004"
                        android:textColor="#7FD4FF"
                        android:textStyle="bold"
                        android:textSize="20sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Mezuniyet"
                        android:textColor="#DCEAF0"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/about_stat_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 YIL"
                        android:textColor="#72E0C9"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Özel Sektör"
                        android:textColor="#DCEAF0"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/about_stat_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="17 YIL"
                        android:textColor="#FFC768"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Kamu"
                        android:textColor="#DCEAF0"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/about_panel_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sahadan Mobil Çözüme"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="MusaCAD; sahada teknik çizimlere hızlı erişim, ölçüm, katman yönetimi, düzenleme ve paylaşım ihtiyaçlarını mobil ortamda bir araya getirmek amacıyla geliştirilen bir CAD çalışma alanıdır. Tasarım yaklaşımının merkezinde mühendislik pratiği, okunabilirlik ve sahada hızlı kullanım yer alır."
                    android:textColor="#C7DCE5"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/openSourceButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="AÇIK KAYNAK VE LİSANSLAR"
                android:textColor="#DDF4FF"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@drawable/feature_chip_bg"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/closeAboutButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="9dp"
                android:text="KAPAT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/primary_action_bg"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="MusaCAD"
                android:textColor="#87A7B6"
                android:textSize="9sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
