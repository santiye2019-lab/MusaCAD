<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/about_blueprint"
        android:scaleType="fitXY"
        android:alpha="0.56"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="720dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/aboutBackButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:background="@drawable/top_action_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MusaCAD"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geliştirici Hakkında"
                        android:textColor="#D4E6EF"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="2 / 2"
                    android:textColor="#D5E8F2"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="58dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:background="#0E9CFF" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="286dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/about_panel_bg">

                <ImageView
                    android:id="@+id/developerPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Musa Otluoğlu" />

                <TextView
                    android:layout_width="184dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="12dp"
                    android:padding="12dp"
                    android:text="“Daha iyi projeler için teknoloji her zaman yanımızda olmalı.”"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:background="@drawable/about_panel_bg" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Musa Otluoğlu"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Makine Mühendisi"
                android:textColor="#20A9FF"
                android:textStyle="bold"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/about_panel_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doğum Yılı ve Yer"
                    android:textColor="#4AAFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="1980 – İstanbul"
                    android:textColor="#E9F3F8"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Eğitim"
                    android:textColor="#4AAFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Atatürk Üniversitesi
Makine Mühendisliği (2004)"
                    android:textColor="#E9F3F8"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Profesyonel Deneyim (Özel Sektör)"
                    android:textColor="#4AAFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="6 yıl, çeşitli inşaat firmalarında Mekanik İşler Şefliği ve koordinatörlük"
                    android:textColor="#E9F3F8"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Kamu Görevi"
                    android:textColor="#4AAFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="17 yıldır belediyelerde kontrol ve denetim mühendisliği görevini sürdürmekteyim."
                    android:textColor="#E9F3F8"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/about_panel_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MusaCAD, sahadaki ihtiyaçlardan doğan, pratik, güvenilir ve kullanıcı dostu bir CAD çözümüdür. Mühendislik tecrübemle geliştirdiğim bu uygulama, mühendislerin ve teknik personelin günlük işlerini kolaylaştırmak için tasarlanmıştır."
                    android:textColor="#D9E9F0"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <Button
                android:id="@+id/closeAboutButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:text="MusaCAD'ı Kullan  ›"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:background="@drawable/primary_action_bg"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fikirden Projeye..."
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="italic"
                android:fontFamily="cursive"
                android:rotation="-3" />

            <Button
                android:id="@+id/openSourceButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:text="Açık Kaynak ve Lisanslar"
                android:textAllCaps="false"
                android:textColor="#96B8C8"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="MusaCAD"
                android:textColor="#7895A4"
                android:textSize="9sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
