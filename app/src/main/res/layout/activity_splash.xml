<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/splash_scene_reference"
        android:scaleType="centerCrop"
        android:alpha="0.24"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#7A04111B" />

    <ScrollView
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="620dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="MusaCAD logosu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MusaCAD"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mobilde Profesyonel CAD Deneyimi"
                android:textColor="#BEEAF2"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/main_panel_bg"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/splashReferenceImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/splash_scene_reference"
                    android:scaleType="centerCrop"
                    android:contentDescription="MusaCAD CAD ve mühendislik referans görseli" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/feature_chip_bg"
                    android:gravity="center"
                    android:text="GÖRÜNTÜLE"
                    android:textColor="#E9FAFC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/feature_chip_bg"
                    android:gravity="center"
                    android:text="ÖLÇ"
                    android:textColor="#E9FAFC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/feature_chip_bg"
                    android:gravity="center"
                    android:text="DÜZENLE"
                    android:textColor="#E9FAFC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/feature_chip_bg"
                    android:gravity="center"
                    android:text="PAYLAŞ"
                    android:textColor="#E9FAFC"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hızlı  •  Güvenilir  •  Pratik  •  Mobil"
                android:textColor="#9CCBD5"
                android:textSize="12sp"
                android:letterSpacing="0.04" />

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/primary_action_bg"
                android:text="BAŞLA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/licenseInfoButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/feature_chip_bg"
                android:text="LİSANS BİLGİSİ"
                android:textColor="#D9F3F6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/aboutLinkButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:text="Geliştirici / Hakkında"
                android:textColor="#9ED7E1"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/splashVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#6FA3AF"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>