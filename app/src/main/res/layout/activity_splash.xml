<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="34dp"
        android:paddingEnd="34dp">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/splash_logo_bg"
            android:elevation="10dp">

            <ImageView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_musacad_mark"
                android:contentDescription="MusaCAD logo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="MusaCAD"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ÇİZ • ÖLÇ • DÜZENLE • HER YERDE"
            android:textColor="#7FD4FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="DWG / DXF • katman • ölçüm • düzenleme • PDF / PNG"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="42dp"
            android:indeterminateTint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Profesyonel CAD çalışma alanı hazırlanıyor…"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="MusaCAD • Mobil CAD Çözümü"
        android:textColor="#BFFFFFFF"
        android:textSize="11sp" />
</FrameLayout>
