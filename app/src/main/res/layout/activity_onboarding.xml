<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.musa.cad.EngineeringBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#43000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="720dp">

            <LinearLayout
                android:id="@+id/introPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="30dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="1 / 2"
                    android:textColor="#91AEC0"
                    android:textSize="11sp" />

                <FrameLayout
                    android:layout_width="98dp"
                    android:layout_height="98dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/splash_logo_bg">
                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_musacad_mark"
                        android:contentDescription="MusaCAD logo" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="MusaCAD"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Profesyonel mobil CAD çalışma alanı"
                    android:textColor="#7FD4FF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="DWG / DXF görüntüleme • ölçü alma • düzenleme • paylaşım"
                    android:textColor="#DCECF5"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/intro_panel_bg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SAHADAN GELEN MOBİL ÇÖZÜM"
                        android:textColor="#6FE3D7"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mühendislik projelerini sahada, ofiste veya hareket hâlindeyken hızlı ve güvenilir biçimde inceleyin."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:gravity="center"
                            android:text="DWG / DXF&#10;GÖRÜNTÜLE"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:background="@drawable/tool_tile_blue" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:gravity="center"
                            android:text="ÖLÇÜ&#10;AL"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:background="@drawable/tool_tile_teal" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:gravity="center"
                            android:text="DÜZENLE"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:background="@drawable/tool_tile_orange" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:gravity="center"
                            android:text="PAYLAŞ"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:background="@drawable/tool_tile_purple" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="“Çizimler artık her yerde…”"
                    android:textColor="#B8D5E6"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <Button
                    android:id="@+id/introNextButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="24dp"
                    android:text="DEVAM"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/primary_action_bg"
                    android:stateListAnimator="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Fikirden projeye • Mobilde mühendislik gücü"
                    android:textColor="#779AAF"
                    android:textSize="10sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bioPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="22dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/bioBackButton"
                        android:layout_width="72dp"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:text="‹  Geri"
                        android:textColor="#BEE7FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="MusaCAD"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="2 / 2"
                        android:textColor="#91AEC0"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Geliştirici Hakkında"
                    android:textColor="#7FD4FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/developerPhoto"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/developer_photo_frame"
                    android:contentDescription="Musa Otluoğlu" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/intro_panel_bg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Musa Otluoğlu"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Makine Mühendisi • MusaCAD Geliştiricisi"
                        android:textColor="#59C8FF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="1980 • İstanbul"
                        android:textColor="#6FE3D7"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Atatürk Üniversitesi&#10;Makine Mühendisliği • 2004"
                        android:textColor="#E8F4FA"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Profesyonel deneyim"
                        android:textColor="#6FE3D7"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Kariyerinin ilk 6 yılında özel inşaat firmalarında Mekanik İşler Şefliği ve mekanik koordinatörlük görevlerinde bulundu. Son 17 yıldır kamuda kontrol ve denetim mühendisliği görevini sürdürmektedir."
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#34557869" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Saha uygulamaları, yapım işleri, mekanik tesisat koordinasyonu ve proje kontrolünde edindiği deneyimi MusaCAD’e aktarmıştır. MusaCAD, sahadaki gerçek ihtiyaçlardan doğan mobil bir CAD çalışma alanı olarak Musa Otluoğlu tarafından geliştirilmiştir."
                        android:textColor="#C7DCE8"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="“Daha verimli, daha güçlü projeler için…”"
                    android:textColor="#8FB7C5"
                    android:textSize="12sp"
                    android:textStyle="italic" />

                <Button
                    android:id="@+id/bioContinueButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:text="MUSACAD’I KULLAN"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/primary_action_bg"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>