<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/licenseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/splash_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="38dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/splash_logo_bg"
            android:elevation="8dp">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_musacad_mark"
                android:contentDescription="MusaCAD logo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MusaCAD"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Profesyonel mobil CAD çalışma alanı"
            android:textColor="#BFD7E5"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/main_panel_bg"
            android:elevation="5dp">

            <TextView
                android:id="@+id/licenseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1 gün ücretsiz deneyin"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Tüm temel görüntüleme, ölçüm, katman, düzenleme ve çıktı özelliklerini 24 saat kullanın."
                android:textColor="#BFD1DA"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <CheckBox
                android:id="@+id/termsCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Lisans ve deneme koşullarını okudum, kabul ediyorum"
                android:textColor="#EAF5F7"
                android:textSize="11sp"
                android:buttonTint="#1AA7FF" />

            <Button
                android:id="@+id/termsButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="LİSANS KOŞULLARINI OKU"
                android:textColor="#D9F1FF"
                android:textSize="11sp"
                android:background="@drawable/feature_chip_bg"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/trialButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="1 GÜNLÜK ÜCRETSİZ DENEMEYİ BAŞLAT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/primary_action_bg"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/main_panel_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lisans kodunuz var mı?"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp" />

            <EditText
                android:id="@+id/licenseCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:hint="MUSACAD-XXXX-XXXX-XXXX"
                android:textColor="#FFFFFF"
                android:textColorHint="#7593A3"
                android:singleLine="true"
                android:inputType="textCapCharacters"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/feature_chip_bg" />

            <Button
                android:id="@+id/activateButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="LİSANS KODUNU ETKİNLEŞTİR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/primary_action_bg"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/licenseMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Lisans kodu altyapısı güvenli imzalı kod sistemiyle etkinleştirilecek."
                android:textColor="#8FB7C5"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="MusaCAD • Lisans anahtarı özel anahtar içermeden doğrulanacak"
            android:textColor="#7190A0"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
