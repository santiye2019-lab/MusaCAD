<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111820">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="#0B3B60">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MUSA CAD" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="20sp" />
        <Button android:id="@+id/openButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="DOSYA AÇ" />
        <ImageButton android:id="@+id/shareButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_share" android:contentDescription="Paylaş" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#FFFFFF" />
    </LinearLayout>
    <TextView android:id="@+id/fileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="Bir DWG veya DXF dosyası açın" android:textColor="#DDE8F0" android:background="#182531" />
    <com.musa.cad.CadView android:id="@+id/cadView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:text="Hazır" android:textColor="#FFFFFF" android:background="#182531" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="64dp" android:fillViewport="true" android:background="#0B3B60">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center">
            <Button android:id="@+id/panButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="GEZİN" />
            <Button android:id="@+id/calibrateButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="ÖLÇEK" />
            <Button android:id="@+id/distanceButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="MESAFE" />
            <Button android:id="@+id/areaButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="ALAN" />
            <Button android:id="@+id/undoButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="GERİ" />
            <Button android:id="@+id/clearButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="TEMİZLE" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
