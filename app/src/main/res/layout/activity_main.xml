<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#061421">

    <!-- Reference header: compact, single-line MusaCAD brand -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#082A42">

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_menu"
            android:contentDescription="Ana menü"
            android:background="@drawable/top_action_bg"
            android:padding="10dp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="7dp"
            android:src="@drawable/ic_musacad_mark"
            android:scaleType="fitCenter"
            android:contentDescription="MusaCAD logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MusaCAD"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="none"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DWG / DXF"
                android:textColor="#9FC4DB"
                android:textSize="8sp"
                android:singleLine="true"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/openButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_open_file"
            android:contentDescription="Dosya aç"
            android:background="@drawable/top_action_bg"
            android:padding="9dp" />

        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_share_pro"
            android:contentDescription="Paylaş"
            android:background="@drawable/top_action_bg"
            android:padding="9dp"
            android:enabled="false"
            android:alpha="0.45" />

        <ImageButton
            android:id="@+id/headerMoreButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_more"
            android:contentDescription="Diğer menü"
            android:background="@drawable/top_action_bg"
            android:padding="9dp" />
    </LinearLayout>

    <!-- File name / edit state -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#071D2C">

        <TextView
            android:id="@+id/fileName"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="middle"
            android:text="Henüz proje açılmadı"
            android:textColor="#E6F2F8"
            android:textStyle="bold"
            android:textSize="10sp"
            android:background="@drawable/feature_chip_bg" />

        <TextView
            android:id="@+id/editStatusText"
            android:layout_width="104dp"
            android:layout_height="32dp"
            android:layout_marginStart="7dp"
            android:gravity="center"
            android:text="Dosya yok"
            android:textColor="#8FB7C5"
            android:textStyle="bold"
            android:textSize="9sp"
            android:singleLine="true"
            android:background="@drawable/feature_chip_bg" />
    </LinearLayout>

    <!-- Reference top quick tools -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#071927">

        <Button
            android:id="@+id/layersButton"
            style="@style/TopQuickBlue"
            android:text="Katman"
            android:drawableTop="@drawable/ic_layers"
            android:enabled="false" />

        <Button
            android:id="@+id/propertiesButton"
            style="@style/TopQuickPurple"
            android:text="Özellik"
            android:drawableTop="@drawable/ic_properties"
            android:enabled="false" />

        <Button
            android:id="@+id/colorButton"
            style="@style/TopQuickYellow"
            android:text="Renk"
            android:drawableTop="@drawable/ic_color"
            android:enabled="false" />

        <Button
            android:id="@+id/lineTypeButton"
            style="@style/TopQuickOrange"
            android:text="Çizgi K."
            android:drawableTop="@drawable/ic_line"
            android:enabled="false" />

        <Button
            android:id="@+id/pointButton"
            style="@style/TopQuickBlue"
            android:text="Nokta"
            android:drawableTop="@drawable/ic_point"
            android:enabled="false" />

        <CheckBox
            android:id="@+id/snapToggle"
            style="@style/TopQuickTeal"
            android:button="@null"
            android:text="Yakalama"
            android:drawableTop="@drawable/ic_snap"
            android:checked="true"
            android:enabled="false" />
    </LinearLayout>

    <!-- Command line, keeps full classic command engine -->
    <LinearLayout
        android:id="@+id/commandBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#061623">

        <TextView
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="Komut:"
            android:textColor="#35D7FF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/feature_chip_bg" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:singleLine="true"
            android:maxLines="1"
            android:hint="L, PL, C, REC, M, CO, RO, E, LA, DI, AA, ZE..."
            android:textColor="#FFFFFF"
            android:textColorHint="#759BB2"
            android:textSize="10sp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:background="@drawable/feature_chip_bg"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters" />

        <!-- Kept for existing binding; keyboard Enter is the reference interaction -->
        <Button
            android:id="@+id/commandSendButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:text="↵" />

        <TextView
            android:layout_width="46dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="TR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:background="@drawable/feature_chip_bg" />
    </LinearLayout>

    <!-- CAD canvas: maximized between tool areas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#07131D">

        <com.musa.cad.CadView
            android:id="@+id/cadView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ScrollView
            android:id="@+id/welcomePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#F207131D"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp"
                    android:background="@drawable/main_panel_bg">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_musacad_mark"
                        android:contentDescription="MusaCAD" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="MusaCAD çalışma alanı"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Klasör düğmesinden DWG / DXF dosyanızı açın."
                        android:textColor="#9EBBC9"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Right-side reference toolbar -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="7dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/main_panel_bg">

            <ImageButton
                android:id="@+id/panButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_pan"
                android:contentDescription="Kaydır"
                android:background="@drawable/top_action_bg"
                android:padding="9dp" />

            <ImageButton
                android:id="@+id/rightFitButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_fit"
                android:contentDescription="Ekrana sığdır"
                android:background="@drawable/top_action_bg"
                android:padding="9dp" />

            <ImageButton
                android:id="@+id/rightZoomInButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_zoom_in"
                android:contentDescription="Yakınlaştır"
                android:background="@drawable/top_action_bg"
                android:padding="9dp" />

            <ImageButton
                android:id="@+id/rightZoomOutButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_zoom_out"
                android:contentDescription="Uzaklaştır"
                android:background="@drawable/top_action_bg"
                android:padding="9dp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="2D"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/tool_tile_blue" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="3D"
                android:enabled="false"
                android:alpha="0.38"
                android:textColor="#587487"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/feature_chip_bg" />

            <ImageButton
                android:id="@+id/rightLayersButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_layers"
                android:contentDescription="Katmanlar"
                android:background="@drawable/top_action_bg"
                android:padding="9dp"
                android:enabled="false"
                android:alpha="0.45" />
        </LinearLayout>
    </FrameLayout>

    <!-- Reference 8 x 2 lower command grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="#081B2A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:weightSum="8">

            <Button android:id="@+id/selectEntityButton" style="@style/BottomGridBlue" android:text="Seç" android:drawableTop="@drawable/ic_select" android:enabled="false" />
            <Button android:id="@+id/lineButton" style="@style/BottomGridBlue" android:text="Çiz" android:drawableTop="@drawable/ic_line" android:enabled="false" />
            <Button android:id="@+id/rectangleButton" style="@style/BottomGridBlue" android:text="Dikdörtgen" android:drawableTop="@drawable/ic_rectangle" android:enabled="false" />
            <Button android:id="@+id/circleButton" style="@style/BottomGridBlue" android:text="Daire" android:drawableTop="@drawable/ic_circle" android:enabled="false" />
            <Button android:id="@+id/moveEntityButton" style="@style/BottomGridGreen" android:text="Taşı" android:drawableTop="@drawable/ic_move" android:enabled="false" />
            <Button android:id="@+id/copyEntityButton" style="@style/BottomGridGreen" android:text="Kopyala" android:drawableTop="@drawable/ic_copy" android:enabled="false" />
            <Button android:id="@+id/rotateEntityButton" style="@style/BottomGridGreen" android:text="Döndür" android:drawableTop="@drawable/ic_rotate" android:enabled="false" />
            <Button android:id="@+id/deleteEntityButton" style="@style/BottomGridOrange" android:text="Sil" android:drawableTop="@drawable/ic_delete" android:enabled="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:weightSum="8">

            <Button android:id="@+id/zoomInButton" style="@style/BottomGridBlue" android:text="Yakınlaştır" android:drawableTop="@drawable/ic_zoom_in" />
            <Button android:id="@+id/zoomOutButton" style="@style/BottomGridBlue" android:text="Uzaklaştır" android:drawableTop="@drawable/ic_zoom_out" />
            <Button android:id="@+id/fitButton" style="@style/BottomGridBlue" android:text="Tümü" android:drawableTop="@drawable/ic_fit" />
            <Button android:id="@+id/bottomLayersButton" style="@style/BottomGridBlue" android:text="Katmanlar" android:drawableTop="@drawable/ic_layers" android:enabled="false" />
            <Button android:id="@+id/bottomMeasureButton" style="@style/BottomGridPurple" android:text="Ölç" android:drawableTop="@drawable/ic_distance" />
            <Button android:id="@+id/textButton" style="@style/BottomGridPurple" android:text="Yazı" android:drawableTop="@drawable/ic_text" android:enabled="false" />
            <Button android:id="@+id/hatchButton" style="@style/BottomGridPurple" android:text="Tarama" android:drawableTop="@drawable/ic_hatch" android:enabled="false" />
            <Button android:id="@+id/moreToolsButton" style="@style/BottomGridBlue" android:text="Diğer" android:drawableTop="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>

    <!-- File tab / finish / save / share / open -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#071A27">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/projectTabsBox"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tabFileName"
                    android:layout_width="150dp"
                    android:layout_height="34dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:text="Dosya açılmadı"
                    android:textColor="#E7F5FA"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:background="@drawable/feature_chip_bg" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/newProjectButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/top_action_bg"
            android:stateListAnimator="@null"
            android:contentDescription="Yeni proje aç" />

        <ImageButton
            android:id="@+id/finishEditButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_done"
            android:contentDescription="Komutu bitir"
            android:background="@drawable/top_action_bg"
            android:padding="9dp"
            android:enabled="false" />

        <ImageButton
            android:id="@+id/saveDxfButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_save"
            android:contentDescription="DXF kaydet"
            android:background="@drawable/top_action_bg"
            android:padding="9dp"
            android:enabled="false" />

        <ImageButton
            android:id="@+id/shareToolButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_share_pro"
            android:contentDescription="Paylaş"
            android:background="@drawable/tool_tile_orange"
            android:padding="9dp"
            android:enabled="false"
            android:alpha="0.45" />

        <ImageButton
            android:id="@+id/quickOpenButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_open_file"
            android:contentDescription="Dosya aç"
            android:background="@drawable/top_action_bg"
            android:padding="9dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Hazır"
        android:textColor="#C8DCE6"
        android:textSize="9sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:background="#061421" />

    <!-- Existing capability anchors. Kept in the layout so old listeners/modes remain intact.
         Their UI entry points are Measure / Other / command line. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <Button android:id="@+id/polylineButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/calibrateButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/distanceButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/areaButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/undoButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/clearButton" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
</LinearLayout>
