<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cad_bg">

    <!-- Reference header: compact, single-line MusaCAD brand -->
    <LinearLayout
        android:id="@+id/editorTopHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/editor_header">

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_menu"
            android:contentDescription="Ana menü"
            android:background="@drawable/top_action_bg"
            android:padding="10dp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="7dp"
            android:src="@drawable/ic_musacad_mark"
            android:scaleType="fitCenter"
            android:contentDescription="MusaCAD logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MusaCAD"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="none"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeStepGranularity="1sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DWG / DXF"
                android:textColor="@color/editor_text_secondary"
                android:textSize="8.5sp"
                android:singleLine="true"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/openButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_open_file"
            android:contentDescription="Dosya aç"
            android:background="@drawable/top_action_bg"
            android:padding="9dp" />

        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_share_pro"
            android:contentDescription="Paylaş"
            android:background="@drawable/top_action_bg"
            android:padding="9dp"
            android:enabled="false"
            android:alpha="0.45" />

        <ImageButton
            android:id="@+id/headerMoreButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_more"
            android:contentDescription="Diğer menü"
            android:background="@drawable/top_action_bg"
            android:padding="9dp" />
    </LinearLayout>

    <!-- Reference file / rendering mode row -->
    <LinearLayout
        android:id="@+id/fileModeBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/editor_file_bar">

        <TextView
            android:id="@+id/fileName"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="middle"
            android:text="Henüz proje açılmadı"
            android:textColor="#EAF7FC"
            android:textStyle="bold"
            android:textSize="9.5sp"
            android:drawableStart="@drawable/ic_open_file"
            android:drawableTint="@color/editor_text_secondary"
            android:drawablePadding="6dp"
            android:background="@drawable/file_tab_bg" />

        <ImageButton
            android:id="@+id/closeFileButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_clear"
            android:contentDescription="Projeyi kapat"
            android:background="@drawable/top_action_bg"
            android:padding="7dp" />

        <TextView
            android:id="@+id/nativeModeChip"
            android:layout_width="86dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="DWG Native ▾"
            android:textColor="#DDF3FB"
            android:textStyle="bold"
            android:textSize="8.5sp"
            android:singleLine="true"
            android:background="@drawable/mode_chip_bg" />

        <TextView
            android:id="@+id/sceneModeChip"
            android:layout_width="98dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Sahne görünümü ▾"
            android:textColor="@color/editor_mode_warn"
            android:textStyle="bold"
            android:textSize="8sp"
            android:singleLine="true"
            android:background="@drawable/mode_chip_selected_bg" />
    </LinearLayout>

    <!-- Reference top quick tools -->
    <LinearLayout
        android:id="@+id/quickToolsBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@color/editor_toolbar">

        <Button
            android:id="@+id/layersButton"
            style="@style/TopQuickBlue"
            android:layout_width="50dp"
            android:layout_weight="0"
            android:layout_height="46dp"
            android:text=""
            android:drawableTop="@drawable/ic_layers"
            android:enabled="false" />

        <Button
            android:id="@+id/propertiesButton"
            style="@style/TopQuickPurple"
            android:layout_width="50dp"
            android:layout_weight="0"
            android:layout_height="46dp"
            android:text=""
            android:drawableTop="@drawable/ic_properties"
            android:enabled="false" />

        <Button
            android:id="@+id/colorButton"
            style="@style/TopQuickYellow"
            android:layout_width="50dp"
            android:layout_weight="0"
            android:layout_height="46dp"
            android:text=""
            android:drawableTop="@drawable/ic_color"
            android:enabled="false" />

        <Button
            android:id="@+id/lineTypeButton"
            style="@style/TopQuickOrange"
            android:layout_width="50dp"
            android:layout_weight="0"
            android:layout_height="46dp"
            android:text=""
            android:drawableTop="@drawable/ic_line"
            android:enabled="false" />

        <Button
            android:id="@+id/pointButton"
            style="@style/TopQuickBlue"
            android:layout_width="50dp"
            android:layout_weight="0"
            android:layout_height="46dp"
            android:text=""
            android:drawableTop="@drawable/ic_point"
            android:enabled="false" />

        <CheckBox
            android:id="@+id/snapToggle"
            style="@style/TopQuickTeal"
            android:layout_width="104dp"
            android:layout_weight="0"
            android:layout_height="46dp"
            android:button="@null"
            android:text="Yakalama ▾"
            android:drawableTop="@drawable/ic_snap"
            android:checked="true"
            android:enabled="false" />
    </LinearLayout>

    <!-- Command line: reference-style compact CAD command entry -->
    <LinearLayout
        android:id="@+id/commandBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/editor_command_bar">

        <TextView
            android:id="@+id/commandLabel"
            android:layout_width="66dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="Komut:"
            android:textColor="@color/editor_cyan"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/feature_chip_bg" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:singleLine="true"
            android:maxLines="1"
            android:hint="L, PL, C, REC, M, CO, RO, E, LA..."
            android:textColor="#FFFFFF"
            android:textColorHint="@color/editor_text_dim"
            android:textSize="9.5sp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:background="@drawable/feature_chip_bg"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters" />

        <Button
            android:id="@+id/commandSendButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:text="↵" />

        <TextView
            android:id="@+id/languageChip"
            android:layout_width="50dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="TR ▾"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="9sp"
            android:background="@drawable/feature_chip_bg" />
    </LinearLayout>

    <!-- CAD canvas: maximized between tool areas -->
    <FrameLayout
        android:id="@+id/editorCanvasFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/editor_canvas">

        <com.musa.cad.CadView
            android:id="@+id/cadView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="64dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Hazır"
            android:textColor="#C8DCE6"
            android:textSize="8.5sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:background="@drawable/feature_chip_bg"
            android:elevation="3dp" />


        <ScrollView
            android:id="@+id/welcomePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#F207131D"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp"
                    android:background="@drawable/main_panel_bg">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_musacad_mark"
                        android:contentDescription="MusaCAD" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="MusaCAD çalışma alanı"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Klasör düğmesinden DWG / DXF dosyanızı açın."
                        android:textColor="#9EBBC9"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Reserved host for the reference-style expandable category panel.
             Checkpoint-01 defines the shell only; category contents are wired in later checkpoints. -->
        <LinearLayout
            android:id="@+id/toolPanelHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="58dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone"
            android:background="@drawable/tool_panel_bg"
            android:elevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/toolPanelTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Araçlar"
                    android:textColor="@color/editor_cyan"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/toolPanelClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_clear"
                    android:contentDescription="Araç panelini kapat"
                    android:background="@drawable/feature_chip_bg"
                    android:padding="8dp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/toolPanelGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false" />
        </LinearLayout>

        <!-- Right-side reference toolbar -->
        <LinearLayout
            android:id="@+id/rightToolRail"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/tool_panel_bg">

            <ImageButton
                android:id="@+id/panButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_pan"
                android:contentDescription="Kaydır"
                android:background="@drawable/top_action_bg"
                android:padding="9dp" />

            <ImageButton
                android:id="@+id/rightFitButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_fit"
                android:contentDescription="Ekrana sığdır"
                android:background="@drawable/top_action_bg"
                android:padding="9dp" />

            <ImageButton
                android:id="@+id/rightZoomInButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_zoom_in"
                android:contentDescription="Yakınlaştır"
                android:background="@drawable/top_action_bg"
                android:padding="9dp" />

            <ImageButton
                android:id="@+id/rightZoomOutButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_zoom_out"
                android:contentDescription="Uzaklaştır"
                android:background="@drawable/top_action_bg"
                android:padding="9dp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="2D"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/tool_tile_blue" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="3D"
                android:enabled="false"
                android:alpha="0.38"
                android:textColor="#587487"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/feature_chip_bg" />

            <ImageButton
                android:id="@+id/rightLayersButton"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_layers"
                android:contentDescription="Katmanlar"
                android:background="@drawable/top_action_bg"
                android:padding="9dp"
                android:enabled="false"
                android:alpha="0.45" />
        </LinearLayout>
    </FrameLayout>

    <!-- Reference-style bottom category navigation.
         Existing command engine remains intact; category wiring is added checkpoint by checkpoint. -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="@color/editor_category_bar">

        <LinearLayout
            android:id="@+id/bottomCategoryBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/groupAnnotateToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="68dp"
                android:layout_height="64dp"
                android:text="Ek açıklama"
                android:drawableTop="@drawable/ic_text" />

            <Button
                android:id="@+id/groupLineToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="62dp"
                android:layout_height="64dp"
                android:text="Çiz"
                android:drawableTop="@drawable/ic_line" />

            <Button
                android:id="@+id/groupEditToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="66dp"
                android:layout_height="64dp"
                android:text="Düzenle"
                android:drawableTop="@drawable/ic_move" />

            <Button
                android:id="@+id/groupLayerToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="Katman"
                android:drawableTop="@drawable/ic_layers" />

            <Button
                android:id="@+id/groupMeasureToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="Ölçüm"
                android:drawableTop="@drawable/ic_distance" />

            <Button
                android:id="@+id/groupDimensionToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="Boyut"
                android:drawableTop="@drawable/ic_scale" />

            <Button
                android:id="@+id/groupColorToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="62dp"
                android:layout_height="64dp"
                android:text="Renk"
                android:drawableTop="@drawable/ic_color" />

            <Button
                android:id="@+id/groupMoreToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="62dp"
                android:layout_height="64dp"
                android:text="Alet"
                android:drawableTop="@drawable/ic_more" />

            <Button
                android:id="@+id/groupLayoutToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="Düzen"
                android:drawableTop="@drawable/ic_rectangle" />

            <Button
                android:id="@+id/groupViewToolsButton"
                style="@style/CategoryBarButton"
                android:layout_width="72dp"
                android:layout_height="64dp"
                android:text="Görsel stil"
                android:drawableTop="@drawable/ic_fit" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Legacy project action row: bindings retained, visual surface replaced by reference editor chrome. -->
    <LinearLayout
        android:id="@+id/legacyProjectActionsBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#071A27">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/projectTabsBox"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tabFileName"
                    android:layout_width="150dp"
                    android:layout_height="34dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:text="Dosya açılmadı"
                    android:textColor="#E7F5FA"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:background="@drawable/feature_chip_bg" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/newProjectButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/top_action_bg"
            android:stateListAnimator="@null"
            android:contentDescription="Yeni proje aç" />

        <ImageButton
            android:id="@+id/finishEditButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_done"
            android:contentDescription="Komutu bitir"
            android:background="@drawable/top_action_bg"
            android:padding="9dp"
            android:enabled="false" />

        <ImageButton
            android:id="@+id/saveDxfButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_save"
            android:contentDescription="DXF kaydet"
            android:background="@drawable/top_action_bg"
            android:padding="9dp"
            android:enabled="false" />

        <ImageButton
            android:id="@+id/shareToolButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_share_pro"
            android:contentDescription="Paylaş"
            android:background="@drawable/tool_tile_orange"
            android:padding="9dp"
            android:enabled="false"
            android:alpha="0.45" />

        <ImageButton
            android:id="@+id/quickOpenButton"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_open_file"
            android:contentDescription="Dosya aç"
            android:background="@drawable/top_action_bg"
            android:padding="9dp" />
    </LinearLayout>



    <!-- Existing capability anchors. Kept in the layout so old listeners/modes remain intact.
         Their UI entry points are Measure / Other / command line. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <!-- Legacy capability anchors kept so MainActivity bindings stay stable during the staged redesign. -->
        <TextView android:id="@+id/editStatusText" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/selectEntityButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/groupShapeToolsButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/lineButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/polylineButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/rectangleButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/circleButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/moveEntityButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/copyEntityButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/rotateEntityButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/deleteEntityButton" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/zoomInButton" android:layout_width="1dp" android:layout_height="1dp" />
