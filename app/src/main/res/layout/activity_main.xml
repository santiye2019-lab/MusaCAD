<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/mainRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111820">
<LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="12dp" android:gravity="center_vertical" android:background="#142536">
<TextView android:id="@+id/appTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="MUSA CAD" android:textSize="20sp" android:textStyle="bold" android:textColor="#F0F6FC"/>
<com.google.android.material.button.MaterialButton android:id="@+id/openButton" style="@style/CadTool" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:text="Aç" app:icon="@drawable/ic_folder" /><com.google.android.material.button.MaterialButton android:id="@+id/shareButton" style="@style/CadTool" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:text="" app:icon="@drawable/ic_share" android:contentDescription="Paylaş"/>
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingLeft="14dp" android:paddingRight="8dp" android:gravity="center_vertical" android:background="#192B3B">
<TextView android:id="@+id/fileName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="middle" android:text="DWG veya DXF çiziminizi açın" android:textSize="12sp" android:textColor="#C5D3E0"/>
<com.google.android.material.button.MaterialButton android:id="@+id/infoButton" style="@style/CadTool" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:text="" app:icon="@drawable/ic_info" android:contentDescription="Çizim bilgisi"/>
</LinearLayout><com.musa.cad.CadView android:id="@+id/cadView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:maxLines="2" android:gravity="center_vertical" android:text="Hazır • Bir çizim açın" android:textSize="12sp" android:textColor="#C5D3E0" android:background="#192B3B"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:paddingHorizontal="6dp" android:gravity="center_vertical" android:background="#142536">
<com.google.android.material.button.MaterialButton android:id="@+id/panButton" style="@style/CadTool" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginHorizontal="3dp" android:text="Gezin" app:icon="@drawable/ic_pan" android:layout_weight="1" app:iconGravity="textTop" app:iconPadding="2dp"/><com.google.android.material.button.MaterialButton android:id="@+id/distanceButton" style="@style/CadTool" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginHorizontal="3dp" android:text="Mesafe" app:icon="@drawable/ic_ruler" android:layout_weight="1" app:iconGravity="textTop" app:iconPadding="2dp"/><com.google.android.material.button.MaterialButton android:id="@+id/areaButton" style="@style/CadTool" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginHorizontal="3dp" android:text="Alan" app:icon="@drawable/ic_area" android:layout_weight="1" app:iconGravity="textTop" app:iconPadding="2dp"/><com.google.android.material.button.MaterialButton android:id="@+id/calibrateButton" style="@style/CadTool" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginHorizontal="3dp" android:text="Ölçek" app:icon="@drawable/ic_scale" android:layout_weight="1" app:iconGravity="textTop" app:iconPadding="2dp"/></LinearLayout><HorizontalScrollView android:layout_width="match_parent" android:layout_height="54dp" android:scrollbars="none" android:background="#142536"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingHorizontal="6dp" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/fitButton" style="@style/CadTool" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:text="Sığdır" app:icon="@drawable/ic_fit" /><com.google.android.material.button.MaterialButton android:id="@+id/layersButton" style="@style/CadTool" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:text="Katman" app:icon="@drawable/ic_layers" android:enabled="false"/><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/snapToggle" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Yakalama" android:textSize="12sp" android:textColor="@color/tool_foreground" app:buttonTint="#40C8BF" android:checked="true" android:enabled="false"/><com.google.android.material.button.MaterialButton android:id="@+id/undoButton" style="@style/CadTool" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:text="Geri" app:icon="@drawable/ic_undo" /><com.google.android.material.button.MaterialButton android:id="@+id/clearButton" style="@style/CadTool" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:text="Temizle" app:icon="@drawable/ic_clear" /></LinearLayout></HorizontalScrollView></LinearLayout>