<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B131A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#0C324D">

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_menu"
            android:contentDescription="Ana menü"
            android:background="@drawable/top_action_bg"
            android:padding="9dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="9dp">
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MusaCAD"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DWG / DXF"
                android:textColor="#9DB7C5"
                android:textSize="9sp"
                android:singleLine="true" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/openButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ic_open_file"
            android:contentDescription="Dosya aç"
            android:background="@drawable/top_action_bg"
            android:padding="9dp" />

        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_share_pro"
            android:contentDescription="Paylaş"
            android:background="@drawable/top_action_bg"
            android:padding="9dp"
            android:enabled="false"
            android:alpha="0.45" />
    </LinearLayout>

    <TextView
        android:id="@+id/fileName"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:text="Henüz proje açılmadı"
        android:textColor="#C9D9E2"
        android:textSize="10sp"
        android:background="#11242F" />

    <HorizontalScrollView
        android:id="@+id/topEditStrip"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:background="#0B1B25">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">
            <Button android:id="@+id/layersButton" style="@style/CadTopButton" android:text="Katman" android:drawableTop="@drawable/ic_layers" android:enabled="false" />
            <Button android:id="@+id/propertiesButton" style="@style/CadTopButton" android:text="Özellik" android:enabled="false" />
            <CheckBox android:id="@+id/snapToggle" style="@style/CadTopButton" android:button="@null" android:text="Nokta" android:drawableTop="@drawable/ic_snap" android:checked="true" android:enabled="false" />
            <Button android:id="@+id/panButton" style="@style/CadTopButton" android:text="Gezin" android:drawableTop="@drawable/ic_pan" />
            <Button android:id="@+id/selectEntityButton" style="@style/CadTopButton" android:text="Seç" android:enabled="false" />
            <Button android:id="@+id/moveEntityButton" style="@style/CadTopButton" android:text="Taşı" android:enabled="false" />
            <Button android:id="@+id/rotateEntityButton" style="@style/CadTopButton" android:text="Döndür" android:enabled="false" />
            <Button android:id="@+id/copyEntityButton" style="@style/CadTopButton" android:text="Kopya" android:enabled="false" />
            <Button android:id="@+id/deleteEntityButton" style="@style/CadTopButton" android:text="Sil" android:enabled="false" />
            <Button android:id="@+id/undoButton" style="@style/CadTopButton" android:text="Geri" android:drawableTop="@drawable/ic_undo" />
            <Button android:id="@+id/saveDxfButton" style="@style/CadTopButton" android:text="Kaydet" android:drawableTop="@drawable/ic_save" android:enabled="false" />
            <Button android:id="@+id/shareToolButton" style="@style/CadTopButton" android:text="Paylaş" android:drawableTop="@drawable/ic_share_pro" android:enabled="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/toolStrip"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:background="#0C1D27">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">
            <Button android:id="@+id/calibrateButton" style="@style/CadTopButton" android:text="Ölçek" android:drawableTop="@drawable/ic_scale" />
            <Button android:id="@+id/distanceButton" style="@style/CadTopButton" android:text="Mesafe" android:drawableTop="@drawable/ic_distance" />
            <Button android:id="@+id/areaButton" style="@style/CadTopButton" android:text="Alan" android:drawableTop="@drawable/ic_area" />
            <Button android:id="@+id/lineButton" style="@style/CadTopButton" android:text="Çizgi" android:drawableTop="@drawable/ic_line" android:enabled="false" />
            <Button android:id="@+id/polylineButton" style="@style/CadTopButton" android:text="Çoklu" android:drawableTop="@drawable/ic_polyline" android:enabled="false" />
            <Button android:id="@+id/rectangleButton" style="@style/CadTopButton" android:text="Dörtgen" android:drawableTop="@drawable/ic_rectangle" android:enabled="false" />
            <Button android:id="@+id/circleButton" style="@style/CadTopButton" android:text="Daire" android:drawableTop="@drawable/ic_circle" android:enabled="false" />
            <Button android:id="@+id/textButton" style="@style/CadTopButton" android:text="Yazı" android:drawableTop="@drawable/ic_text" android:enabled="false" />
            <Button android:id="@+id/finishEditButton" style="@style/CadTopButton" android:text="Bitir" android:drawableTop="@drawable/ic_done" android:enabled="false" />
            <Button android:id="@+id/zoomInButton" style="@style/CadTopButton" android:text="Yakın +" android:drawableTop="@drawable/ic_zoom_in" />
            <Button android:id="@+id/zoomOutButton" style="@style/CadTopButton" android:text="Yakın -" android:drawableTop="@drawable/ic_zoom_out" />
            <Button android:id="@+id/fitButton" style="@style/CadTopButton" android:text="Sığdır" android:drawableTop="@drawable/ic_fit" />
            <Button android:id="@+id/clearButton" style="@style/CadTopButton" android:text="Temizle" android:drawableTop="@drawable/ic_clear" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/commandBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:background="#071820">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Komut:"
            android:textColor="#6FE3D7"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />
        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:hint="LINE, PL, C, M, CO, E, LA, PR, ZE..."
            android:textColor="#FFFFFF"
            android:textColorHint="#66818D"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:background="#102A35"
            android:imeOptions="actionDone" />
        <Button
            android:id="@+id/commandSendButton"
            android:layout_width="52dp"
            android:layout_height="38dp"
            android:layout_marginStart="5dp"
            android:text="↵"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/primary_action_bg" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.musa.cad.CadView
            android:id="@+id/cadView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ScrollView
            android:id="@+id/welcomePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#0B131A"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MusaCAD"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="DWG / DXF görüntüleme • ölçüm • düzenleme"
                    android:textColor="#AFC6D3"
                    android:textSize="12sp"
                    android:gravity="center" />
                <Button
                    android:id="@+id/quickOpenButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:text="DWG / DXF DOSYASI AÇ"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_open_file"
                    android:drawablePadding="8dp"
                    android:background="@drawable/primary_action_bg"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Komut satırı: LINE • PL • CIRCLE • MOVE • COPY • ERASE • LAYER • PROPERTIES • ZE"
                    android:textColor="#6F8D9C"
                    android:textSize="10sp"
                    android:gravity="center" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/documentTabScroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:visibility="gone"
        android:background="#091922">
        <LinearLayout
            android:id="@+id/documentTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Hazır"
        android:textColor="#DDEAF0"
        android:textSize="10sp"
        android:background="#102631" />
</LinearLayout>
