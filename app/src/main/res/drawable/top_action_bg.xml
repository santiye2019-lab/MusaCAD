<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#2E7184" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#18313E" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#174D61" />
            <stroke android:width="1dp" android:color="#2E7184" />
        </shape>
    </item>
</selector>
