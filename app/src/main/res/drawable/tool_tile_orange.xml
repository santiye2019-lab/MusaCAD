<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#2A2118"/><corners android:radius="13dp"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#84521C"/><stroke android:width="2dp" android:color="#FFC86D"/><corners android:radius="13dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#75491C"/><corners android:radius="13dp"/></shape></item>
    <item><shape><solid android:color="#58381D"/><stroke android:width="1dp" android:color="#7C522C"/><corners android:radius="13dp"/></shape></item>
</selector>
