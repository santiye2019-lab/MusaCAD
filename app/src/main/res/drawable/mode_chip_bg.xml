<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#214B5C" />
            <stroke android:width="1dp" android:color="#35D7FF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#132F3E" />
            <stroke android:width="1dp" android:color="#29576A" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
