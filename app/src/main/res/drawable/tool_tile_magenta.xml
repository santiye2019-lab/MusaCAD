    <item android:state_selected="true"><shape><solid android:color="#8A356E"/><stroke android:width="2dp" android:color="#FF9DDC"/><corners android:radius="13dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#74305F"/><corners android:radius="13dp"/></shape></item>
    <item><shape><solid android:color="#5B284A"/><stroke android:width="1dp" android:color="#87406F"/><corners android:radius="13dp"/></shape></item>
</selector>
