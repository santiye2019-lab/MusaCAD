<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#24687B" />
            <stroke android:width="1.5dp" android:color="#35D7FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#122832" />
            <stroke android:width="1dp" android:color="#1B3C48" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18495B" />
            <stroke android:width="1dp" android:color="#2E7184" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
