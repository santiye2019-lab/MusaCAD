<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0E2029" />
            <stroke android:width="1dp" android:color="#18333F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#174D5E" android:endColor="#167F7A" />
            <stroke android:width="1.5dp" android:color="#42E2CF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#174D5E" android:endColor="#167F7A" />
            <stroke android:width="1.5dp" android:color="#42E2CF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#245D72" />
            <stroke android:width="1dp" android:color="#54C9D4" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#132A35" />
            <stroke android:width="1dp" android:color="#1F4250" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
