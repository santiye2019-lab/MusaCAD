<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#201D29"/><corners android:radius="13dp"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#5A3F83"/><stroke android:width="2dp" android:color="#D8B8FF"/><corners android:radius="13dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#4E386E"/><corners android:radius="13dp"/></shape></item>
    <item><shape><solid android:color="#3A2E56"/><stroke android:width="1dp" android:color="#655084"/><corners android:radius="13dp"/></shape></item>
</selector>
