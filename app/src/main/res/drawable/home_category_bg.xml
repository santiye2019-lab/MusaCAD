<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#174A5B" />
            <stroke android:width="1dp" android:color="#35D7FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#102832" />
            <stroke android:width="1dp" android:color="#214B59" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
