<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A3321" />
            <stroke android:width="1.5dp" android:color="#FFD36B" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#263A3E" android:endColor="#263126" />
            <stroke android:width="1.5dp" android:color="#DFAE46" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
