<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#174858" android:endColor="#155D62" />
            <stroke android:width="1.5dp" android:color="#35D7FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1C4C5D" />
            <stroke android:width="1dp" android:color="#2FBFD9" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#102631" />
            <stroke android:width="1dp" android:color="#1C4251" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
