<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#16242E"/><corners android:radius="13dp"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#176B9B"/><stroke android:width="2dp" android:color="#79D9FF"/><corners android:radius="13dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#195D86"/><corners android:radius="13dp"/></shape></item>
    <item><shape><solid android:color="#123F63"/><stroke android:width="1dp" android:color="#24658D"/><corners android:radius="13dp"/></shape></item>
</selector>
