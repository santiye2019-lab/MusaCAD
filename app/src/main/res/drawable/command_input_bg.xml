<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#091E2A" />
            <stroke android:width="1.5dp" android:color="#35D7FF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A1F2C" />
            <stroke android:width="1dp" android:color="#254A5A" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
