<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#235268" />
            <stroke android:width="1dp" android:color="#35D7FF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#153747" />
            <stroke android:width="1dp" android:color="#2B667B" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
