<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#176878" android:endColor="#15716C" />
            <stroke android:width="1.5dp" android:color="#4CE6F4" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#163748" android:endColor="#102A37" />
            <stroke android:width="1dp" android:color="#2D6577" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
