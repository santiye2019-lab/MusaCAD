    <item android:state_selected="true"><shape><solid android:color="#8B741C"/><stroke android:width="2dp" android:color="#FFE98A"/><corners android:radius="13dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#75631D"/><corners android:radius="13dp"/></shape></item>
    <item><shape><solid android:color="#5D4D19"/><stroke android:width="1dp" android:color="#88722C"/><corners android:radius="13dp"/></shape></item>
</selector>
