<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#162522"/><corners android:radius="13dp"/></shape></item>
    <item android:state_checked="true"><shape><solid android:color="#14786F"/><stroke android:width="2dp" android:color="#6EF4DC"/><corners android:radius="13dp"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#14786F"/><stroke android:width="2dp" android:color="#6EF4DC"/><corners android:radius="13dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#17655F"/><corners android:radius="13dp"/></shape></item>
    <item><shape><solid android:color="#124D49"/><stroke android:width="1dp" android:color="#277A72"/><corners android:radius="13dp"/></shape></item>
</selector>
